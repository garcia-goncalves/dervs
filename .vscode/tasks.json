{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy para a VPS",
      "detail": "Publica o commit atual (ja enviado ao GitHub) direto no servidor",
      "type": "shell",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vps.ps1" },
      "linux": { "command": "bash scripts/deploy-vps.sh" },
      "osx": { "command": "bash scripts/deploy-vps.sh" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Deploy: voltar para a versao anterior",
      "detail": "Desfaz o ultimo deploy no servidor",
      "type": "shell",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vps.ps1 -Voltar" },
      "linux": { "command": "bash scripts/deploy-vps.sh --voltar" },
      "osx": { "command": "bash scripts/deploy-vps.sh --voltar" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
